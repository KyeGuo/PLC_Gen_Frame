FUNCTION_BLOCK AutomaticDoorControl
VAR_INPUT
    ProximitySensor : BOOL;
    ElapsedTime : DINT; (* Changed from TIME to DINT, representing milliseconds *)
END_VAR

VAR_OUTPUT
    DoorOpen : BOOL;
END_VAR

VAR
    DoorOpenDuration : DINT := 5000; (* 5 seconds in milliseconds *)
END_VAR

// Main control logic
IF NOT ProximitySensor THEN
    DoorOpen := FALSE;
ELSE
    DoorOpen := TRUE;
    ASSERT(ElapsedTime >= 0); (* Ensure elapsed time is non-negative *)
END_IF;

// Invariant assertion for open duration
ASSERT(DoorOpenDuration > 0);

END_FUNCTION_BLOCK