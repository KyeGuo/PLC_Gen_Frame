<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject xmlns="http://www.beckhoff.com/TC/PLC">
  <POU Name="FB_BaseControl" Id="{FB_BaseControl_UID}" AdapterSource="" Generated="false" Internal="false" Namespace="Base" Type="FunctionBlock" Category="2" >
    <Declaration><![CDATA[
FUNCTION_BLOCK FB_BaseControl
VAR PUBLIC
    (* 输入接口 *)
    Enable: BOOL; // 系统使能信号
    Reset: BOOL; // 故障复位信号
    EmergencyStop: BOOL; // 紧急停止信号
    
    (* 输出接口 *)
    Status: E_ControlStatus; // 运行状态
    FaultCode: WORD; // 当前故障码
    FaultActive: BOOL; // 故障激活标志
    RunTime: UDINT; // 累计运行时间(ms)
    StatusWord: WORD; // 状态字(符合SIL2标准)
    
    (* 保护参数 *)
    SafetyDelay: UDINT := 10; // 安全状态延迟时间(ms)
END_VAR
VAR PROTECTED
    (* 内部状态变量 *)
    _previousEnable: BOOL;
    _previousReset: BOOL;
    _previousEmergencyStop: BOOL;
    _runTimeCounter: UDINT;
    _safetyTimer: UDINT;
    _faultLatch: BOOL;
    _statusWordBits: ST_StatusWordBits;
    
    (* SIL2安全变量 *)
    _faultCodeRedundant: WORD; // 故障码冗余存储
    _faultActiveRedundant: BOOL; // 故障激活冗余标志
END_VAR
]]></Declaration>
    <Implementation><![CDATA[
METHOD FB_Init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode : BOOL;
END_VAR
    // 初始化变量
    Status := E_ControlStatus.Idle;
    FaultCode := 0;
    FaultActive := FALSE;
    RunTime := 0;
    StatusWord := 0;
    _runTimeCounter := 0;
    _safetyTimer := 0;
    _faultLatch := FALSE;
    _faultCodeRedundant := 0;
    _faultActiveRedundant := FALSE;
    
    // 初始化状态字
    _statusWordBits := (Idle := TRUE);
    StatusWord := StatusWordToWord(_statusWordBits);
    
    FB_Init := TRUE;
END_METHOD

METHOD Cyclic
VAR
    currentTime: UDINT;
END_VAR
    // 获取当前时间(ms)
    currentTime := TON_Internal.PT;
    
    // 处理紧急停止（最高优先级）
    IF EmergencyStop AND NOT _previousEmergencyStop THEN
        SetFault(100); // 紧急停止故障码
    END_IF
    
    // 处理复位信号
    IF Reset AND NOT _previousReset THEN
        ResetFault();
    END_IF
    
    // 处理使能信号
    IF Enable AND NOT _previousEnable THEN
        IF NOT FaultActive THEN
            Status := E_ControlStatus.Running;
            _statusWordBits := (Running := TRUE, Idle := FALSE);
        END_IF
    ELSIF NOT Enable AND _previousEnable THEN
        Status := E_ControlStatus.Stopped;
        _statusWordBits := (Stopped := TRUE, Idle := FALSE, Running := FALSE);
    END_IF
    
    // 故障状态处理
    IF FaultActive THEN
        Status := E_ControlStatus.Fault;
        _statusWordBits := (Fault := TRUE, Idle := FALSE, Running := FALSE, Stopped := FALSE);
        
        // SIL2安全：故障时启动安全定时器
        IF _safetyTimer = 0 THEN
            _safetyTimer := currentTime;
        ELSIF currentTime - _safetyTimer >= SafetyDelay THEN
            EnterSafeState();
        END_IF
    ELSE
        _safetyTimer := 0;
    END_IF
    
    // 运行时间统计
    IF Status = E_ControlStatus.Running AND NOT FaultActive THEN
        _runTimeCounter := _runTimeCounter + 1;
        RunTime := _runTimeCounter;
    END_IF
    
    // 更新状态字
    StatusWord := StatusWordToWord(_statusWordBits);
    
    // 更新历史变量
    _previousEnable := Enable;
    _previousReset := Reset;
    _previousEmergencyStop := EmergencyStop;
    
    // SIL2安全：冗余检查
    IF FaultCode <> _faultCodeRedundant OR FaultActive <> _faultActiveRedundant THEN
        SetFault(200); // 数据不一致故障
    END_IF
END_METHOD

METHOD PROTECTED SetFault
VAR_INPUT
    code: WORD;
END_VAR
    // SIL2安全：双冗余故障置位
    FaultCode := code;
    _faultCodeRedundant := code;
    FaultActive := TRUE;
    _faultActiveRedundant := TRUE;
    _faultLatch := TRUE;
    
    // 更新状态字
    _statusWordBits.Fault := TRUE;
    _statusWordBits.Running := FALSE;
    _statusWordBits.Stopped := FALSE;
    _statusWordBits.Idle := FALSE;
END_METHOD

METHOD PROTECTED ResetFault
    // SIL2安全：双冗余故障复位
    FaultCode := 0;
    _faultCodeRedundant := 0;
    FaultActive := FALSE;
    _faultActiveRedundant := FALSE;
    _faultLatch := FALSE;
    
    // 更新状态
    IF Enable THEN
        Status := E_ControlStatus.Running;
        _statusWordBits := (Running := TRUE, Idle := FALSE);
    ELSE
        Status := E_ControlStatus.Idle;
        _statusWordBits := (Idle := TRUE, Running := FALSE);
    END_IF
END_METHOD

METHOD PROTECTED EnterSafeState
    // SIL2安全：进入安全状态
    // 此处应添加具体的安全输出逻辑
    // 例如：关闭所有输出、切断电源等
    
    // 更新状态字
    _statusWordBits.SafeState := TRUE;
END_METHOD

METHOD PROTECTED StatusWordToWord : WORD
VAR_INPUT
    bits: ST_StatusWordBits;
END_VAR
    // 将状态位转换为状态字
    StatusWordToWord := 0;
    IF bits.Idle THEN StatusWordToWord := StatusWordToWord OR 16#0001; END_IF;
    IF bits.Running THEN StatusWordToWord := StatusWordToWord OR 16#0002; END_IF;
    IF bits.Stopped THEN StatusWordToWord := StatusWordToWord OR 16#0004; END_IF;
    IF bits.Fault THEN StatusWordToWord := StatusWordToWord OR 16#0008; END_IF;
    IF bits.SafeState THEN StatusWordToWord := StatusWordToWord OR 16#0010; END_IF;
    IF bits.Warning THEN StatusWordToWord := StatusWordToWord OR 16#0020; END_IF;
END_METHOD
END_FUNCTION_BLOCK
]]></Implementation>
  </POU>
  <DataTypes>
    <DataType Name="E_ControlStatus" Id="{E_ControlStatus_UID}" Type="Enum" >
      <Declaration><![CDATA[
TYPE E_ControlStatus:
(
    Idle := 0, // 空闲状态
    Running := 1, // 运行状态
    Stopped := 2, // 停止状态
    Fault := 3 // 故障状态
);
END_TYPE
]]></Declaration>
    </DataType>
    <DataType Name="ST_StatusWordBits" Id="{ST_StatusWordBits_UID}" Type="Struct" >
      <Declaration><![CDATA[
TYPE ST_StatusWordBits:
STRUCT
    Idle: BOOL; // 空闲状态位
    Running: BOOL; // 运行状态位
    Stopped: BOOL; // 停止状态位
    Fault: BOOL; // 故障状态位
    SafeState: BOOL; // 安全状态位
    Warning: BOOL; // 警告状态位
    Reserved: ARRAY[0..9] OF BOOL; // 保留位
END_STRUCT
END_TYPE
]]></Declaration>
    </DataType>
  </DataTypes>
  <Attributes>
    <Attribute Name="TcPlcVersion" Version="3.1.4024.0"/>
  </Attributes>
</TcPlcObject>