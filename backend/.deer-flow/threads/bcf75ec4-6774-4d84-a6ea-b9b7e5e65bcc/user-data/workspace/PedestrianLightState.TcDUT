<POU xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" Name="PedestrianLightState" Type="DUT" ID="{00000000-0000-0000-0000-000000000000}" Version="1.0.0.0" Company="" Author="" Contact="" Comment="行人交通灯状态枚举">
  <Declaration><Text><![CDATA[TYPE PedestrianLightState :
    (
        NORMAL,          // 正常状态：汽车绿灯，计数器0
