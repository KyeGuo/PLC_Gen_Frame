// Automated Parking Controller Main Function Block
// Complies with all user requirements and 8 formal property validation rules

FUNCTION_BLOCK FB_AutomatedParkingController
VAR_INPUT
    i_EntryGateSensor : BOOL;               // Entry gate vehicle detection sensor
    i_ExitGateSensor : BOOL;                // Exit gate vehicle detection sensor
    i_CarDetected : BOOL;                   // Pickup car detection sensor
    i_EmergencyStop : BOOL;                 // Emergency stop signal (Safety-Critical)
    i_PickupCarID : UINT;                   // Requested car ID for pickup (New parameter)
END_VAR
VAR_OUTPUT
    o_ParkingSpaceNumber : UINT;            // Assigned parking spot number (0 if none)
    o_RetrievalInProgress : BOOL;           // TRUE when pickup operation in progress
    o_EntryGateOpen : BOOL;                 // Entry gate open command
    o_ExitGateOpen : BOOL;                  // Exit gate open command
    o_SystemStatus : UINT;                  // System status code (0=Normal, 1=Emergency, 2=Full)
    o_PickupCarFound : BOOL;                // TRUE if requested car was found (New output)
END_VAR
VAR
    // Internal state tracking
    ParkingSpots : ARRAY[1..100] OF BOOL;   // Parking spot occupancy status (TRUE=occupied)
    i : INT;                                // Loop variable
    j : INT;                                // Additional loop variable for car ID lookup
    
    // Operation states
    EntryInProgress : BOOL;                 // Entry operation active flag
    ExitInProgress : BOOL;                  // Exit operation active flag
    PickupInProgress : BOOL;                // Pickup operation active flag
    
    // Timers and debounce
    EntrySensorDebounce : TON;              // Entry sensor debounce timer
    ExitSensorDebounce : TON;               // Exit sensor debounce timer
    PickupSensorDebounce : TON;             // Pickup sensor debounce timer
    
    // Gate control
    EntryGateTimer : TOF;                   // Entry gate open duration timer
    ExitGateTimer : TOF;                    // Exit gate open duration timer
    
    // Movement control
    MoveCarResult : BOOL;                   // Result from MoveCarToExitGate function
    TargetSpot : UINT;                      // Target spot for pickup
    CarFound : BOOL;                        // Flag indicating if car was found for pickup
    
    // Child function blocks
    EntryGate : FB_EntryGateControl;        // Entry gate control instance
    ExitGate : FB_ExitGateControl;          // Exit gate control instance
END_VAR

// =============================
// Safety-Critical Emergency Stop (Property 8 Compliance)
// =============================
IF i_EmergencyStop THEN
    // Immediately halt all operations and enter safe state
    o_RetrievalInProgress := FALSE;
    o_EntryGateOpen := FALSE;
    o_ExitGateOpen := FALSE;
    o_ParkingSpaceNumber := 0;
    o_SystemStatus := 1; // Emergency state
    o_PickupCarFound := FALSE;
    
    // Reset internal states
    EntryInProgress := FALSE;
    ExitInProgress := FALSE;
    PickupInProgress := FALSE;
    CarFound := FALSE;
    
    // Reset timers
    EntrySensorDebounce(IN := FALSE);
    ExitSensorDebounce(IN := FALSE);
    PickupSensorDebounce(IN := FALSE);
    EntryGateTimer(IN := FALSE);
    ExitGateTimer(IN := FALSE);
    
    // Reset child function blocks
    EntryGate(i_EntrySensor := FALSE, i_EmergencyStop := TRUE);
    ExitGate(i_ExitSensor := FALSE, i_EmergencyStop := TRUE);
    
    RETURN;
END_IF;

// =============================
// Entry Gate Management (Requirements 1 & 2)
// =============================
// Debounce entry sensor
EntrySensorDebounce(IN := i_EntryGateSensor, PT := T#200MS);

// Process entry request
IF EntrySensorDebounce.Q AND NOT EntryInProgress AND NOT PickupInProgress THEN
    EntryInProgress := TRUE;
    
    // Find and assign first available parking spot (Property 1, 2 Compliance)
    // Implementation 1: Using internal array
    o_ParkingSpaceNumber := 0;
    FOR i := 1 TO 100 DO
        IF NOT ParkingSpots[i] THEN
            ParkingSpots[i] := TRUE;   // Mark spot as occupied
            o_ParkingSpaceNumber := i; // Output assigned spot number
            BREAK;
        END_IF;
    END_FOR;
    
    // Property 3 Compliance: Always provide response
    IF o_ParkingSpaceNumber > 0 THEN
        // Spot assigned successfully
        o_EntryGateOpen := TRUE;
        EntryGateTimer(IN := TRUE, PT := T#10S); // Open gate for 10 seconds
        o_SystemStatus := 0; // Normal operation
        
        // Update global status
        g_ParkingSpotStatus[o_ParkingSpaceNumber] := TRUE;
        g_LastCarID := g_LastCarID + 1;
        g_CarSpotMapping[o_ParkingSpaceNumber] := g_LastCarID;
        g_AvailableSpots := g_AvailableSpots - 1;
    ELSE
        // No available spots (Property 2 Compliance)
        o_EntryGateOpen := FALSE;
        o_SystemStatus := 2; // Lot full
    END_IF;
END_IF;

// Monitor entry gate timer
EntryGateTimer(IN := EntryInProgress);
IF EntryGateTimer.Q THEN
    o_EntryGateOpen := FALSE;
    EntryInProgress := FALSE;
END_IF;

// Reset entry progress when sensor clears
IF NOT i_EntryGateSensor AND EntryInProgress THEN
    EntryInProgress := FALSE;
    IF NOT EntryGateTimer.Q THEN
        o_EntryGateOpen := FALSE;
    END_IF;
END_IF;

// =============================
// Exit Gate Management (Requirement 3)
// =============================
// Debounce exit sensor
ExitSensorDebounce(IN := i_ExitGateSensor, PT := T#200MS);

// Process exit request
IF ExitSensorDebounce.Q AND NOT ExitInProgress THEN
    ExitInProgress := TRUE;
    
    // Release parking spot (Property 7 Compliance)
    IF o_ParkingSpaceNumber > 0 THEN
        ParkingSpots[o_ParkingSpaceNumber] := FALSE; // Mark spot as available
        
        // Update global status
        g_ParkingSpotStatus[o_ParkingSpaceNumber] := FALSE;
        g_CarSpotMapping[o_ParkingSpaceNumber] := 0;
        g_AvailableSpots := g_AvailableSpots + 1;
        
        // Open exit gate
        o_ExitGateOpen := TRUE;
        ExitGateTimer(IN := TRUE, PT := T#10S); // Open gate for 10 seconds
        
        // Reset output (Requirement 3)
        o_ParkingSpaceNumber := 0;
    END_IF;
END_IF;

// Monitor exit gate timer
ExitGateTimer(IN := ExitInProgress);
IF ExitGateTimer.Q THEN
    o_ExitGateOpen := FALSE;
    ExitInProgress := FALSE;
END_IF;

// Reset exit progress when sensor clears
IF NOT i_ExitGateSensor AND ExitInProgress THEN
    ExitInProgress := FALSE;
    IF NOT ExitGateTimer.Q THEN
        o_ExitGateOpen := FALSE;
    END_IF;
END_IF;

// =============================
// Pickup Management (Requirement 4)
// =============================
// Debounce pickup sensor
PickupSensorDebounce(IN := i_CarDetected, PT := T#200MS);

// Process pickup request
IF PickupSensorDebounce.Q AND NOT PickupInProgress AND i_PickupCarID > 0 THEN
    PickupInProgress := TRUE;
    o_RetrievalInProgress := TRUE; // Set retrieval in progress flag
    
    // Find parking spot for requested car ID (Optimized logic)
    // Property 4 Compliance: Verify car is parked before initiating pickup
    TargetSpot := 0;
    CarFound := FALSE;
    FOR j := 1 TO 100 DO
        IF ParkingSpots[j] AND (g_CarSpotMapping[j] = i_PickupCarID) THEN
            TargetSpot := j;
            CarFound := TRUE;
            o_PickupCarFound := TRUE;
            BREAK;
        END_IF;
    END_FOR;
    
    // Set output flag indicating if car was found
    o_PickupCarFound := CarFound;
END_IF;

// Execute pickup operation if car was found
IF PickupInProgress AND CarFound THEN
    // Property 6 Compliance: Only one movement at a time
    IF NOT g_VehicleMovementInProgress THEN
        // Call MoveCarToExitGate function with emergency stop parameter (Requirement 5)
        MoveCarResult := FUN_MoveCarToExitGate(i_SpotNumber := TargetSpot, i_EmergencyStop := i_EmergencyStop);
        
        IF MoveCarResult THEN
            // Pickup completed successfully (Property 5 Compliance)
            ParkingSpots[TargetSpot] := FALSE; // Release parking spot
            
            // Update global status
            g_ParkingSpotStatus[TargetSpot] := FALSE;
            g_CarSpotMapping[TargetSpot] := 0;
            g_AvailableSpots := g_AvailableSpots + 1;
            
            // Reset flags and outputs
            PickupInProgress := FALSE;
            o_RetrievalInProgress := FALSE;
            o_ParkingSpaceNumber := 0;
            TargetSpot := 0;
            CarFound := FALSE;
            o_PickupCarFound := FALSE;
            
            // Open exit gate for departing car
            o_ExitGateOpen := TRUE;
            ExitGateTimer(IN := TRUE, PT := T#10S);
            
            // Update statistics
            g_TotalPickupsPerformed := g_TotalPickupsPerformed + 1;
        ELSE
            // Pickup in progress
            o_RetrievalInProgress := TRUE;
        END_IF;
    END_IF;
ELSIF PickupInProgress AND NOT CarFound THEN
    // Requested car was not found - reset pickup operation
    PickupInProgress := FALSE;
    o_RetrievalInProgress := FALSE;
    o_PickupCarFound := FALSE;
    TargetSpot := 0;
END_IF;

// =============================
// Update global status and outputs
// =============================
o_RetrievalInProgress := PickupInProgress;

// Update system status
IF g_AvailableSpots = 0 THEN
    o_SystemStatus := 2; // Lot full
ELSIF i_EmergencyStop THEN
    o_SystemStatus := 1; // Emergency
ELSE
    o_SystemStatus := 0; // Normal
END_IF;

// Sync global parking status
FOR i := 1 TO 100 DO
    g_ParkingSpotStatus[i] := ParkingSpots[i];
END_FOR;

END_FUNCTION_BLOCK