FUNCTION_BLOCK FB_DroneChargingStation
VAR_INPUT
    Drone1BatteryLevel : INT := 0; (* Battery level of Drone 1 (0-100%) *)
    Drone2BatteryLevel : INT := 0; (* Battery level of Drone 2 (0-100%) *)
    Drone3BatteryLevel : INT := 0; (* Battery level of Drone 3 (0-100%) *)
    ChargingTime : TIME := T#30s; (* Charging time required for each drone *)
END_VAR
VAR_OUTPUT
    Drone1Status : BOOL := FALSE; (* Status of Drone 1 *)
    Drone2Status : BOOL := FALSE; (* Status of Drone 2 *)
    Drone3Status : BOOL := FALSE; (* Status of Drone 3 *)
    ChargingStationStatus : BOOL := FALSE; (* Charging station status *)
    DroneDeployed : BOOL := FALSE; (* Indicates if a drone is deployed *)
END_VAR
VAR
    TimeRemaining : TIME := ChargingTime; (* Remaining charging time for the current charging operation *)
    PrevChargingTime : TIME := T#0S; (* Previous charging time value *)
    PrevStationStatus : BOOL := FALSE; (* Previous charging station status *)
    LowBatteryDrone : BOOL := FALSE; (* Flag indicating low battery drone detected *)
    ChargingStartTime : TIME := T#0S; (* Timestamp when charging started *)
    Drone1Battery : INT := 0; (* Validated battery level for Drone 1 *)
    Drone2Battery : INT := 0; (* Validated battery level for Drone 2 *)
    Drone3Battery : INT := 0; (* Validated battery level for Drone 3 *)
END_VAR

// 输入范围检查：确保电池电量值在0-100之间
Drone1Battery := Drone1BatteryLevel;
IF Drone1Battery < 0 THEN
    Drone1Battery := 0;
ELSIF Drone1Battery > 100 THEN
    Drone1Battery := 100;
END_IF

Drone2Battery := Drone2BatteryLevel;
IF Drone2Battery < 0 THEN
    Drone2Battery := 0;
ELSIF Drone2Battery > 100 THEN
    Drone2Battery := 100;
END_IF

Drone3Battery := Drone3BatteryLevel;
IF Drone3Battery < 0 THEN
    Drone3Battery := 0;
ELSIF Drone3Battery > 100 THEN
    Drone3Battery := 100;
END_IF

// Store previous values for edge detection
PrevChargingTime := ChargingTime;
PrevStationStatus := ChargingStationStatus;

// 紧急安全控制：充电时间为零时立即停止所有充电操作
IF (ChargingTime = T#0S AND PrevChargingTime > T#0S AND PrevStationStatus) THEN
  Drone1Status := FALSE;
  Drone2Status := FALSE;
  Drone3Status := FALSE;
  ChargingStationStatus := FALSE;
  TimeRemaining := T#0S;
END_IF

// 部署安全保障：低于10%电量阻止部署
IF (Drone1Battery < 10 OR Drone2Battery < 10 OR Drone3Battery < 10) AND DroneDeployed THEN
  DroneDeployed := FALSE;
END_IF

// 智能充电管理：按优先级处理低电量无人机
LowBatteryDrone := FALSE;

// Check Drone 1 first
IF NOT Drone1Status AND Drone1Battery < 20 AND ChargingTime > T#0S AND NOT DroneDeployed THEN
  Drone1Status := TRUE;
  ChargingStartTime := TON(CURT);
  ChargingStationStatus := TRUE;
  LowBatteryDrone := TRUE;
ELSIF Drone1Status THEN
  // 充电进度实时更新 - 使用系统时间计算，不受程序周期影响
  TimeRemaining := ChargingTime - (TON(CURT) - ChargingStartTime);
  IF TimeRemaining <= T#0S THEN
    Drone1Status := FALSE;
    ChargingStationStatus := FALSE;
  END_IF
END_IF

// Check Drone 2 if no low battery drone found
IF NOT LowBatteryDrone AND NOT Drone2Status AND Drone2Battery < 20 AND ChargingTime > T#0S AND NOT DroneDeployed THEN
  Drone2Status := TRUE;
  ChargingStartTime := TON(CURT);
  ChargingStationStatus := TRUE;
  LowBatteryDrone := TRUE;
ELSIF Drone2Status THEN
  // 充电进度实时更新 - 使用系统时间计算，不受程序周期影响
  TimeRemaining := ChargingTime - (TON(CURT) - ChargingStartTime);
  IF TimeRemaining <= T#0S THEN
    Drone2Status := FALSE;
    ChargingStationStatus := FALSE;
  END_IF
END_IF

// Check Drone 3 if no low battery drone found
IF NOT LowBatteryDrone AND NOT Drone3Status AND Drone3Battery < 20 AND ChargingTime > T#0S AND NOT DroneDeployed THEN
  Drone3Status := TRUE;
  ChargingStartTime := TON(CURT);
  ChargingStationStatus := TRUE;
  LowBatteryDrone := TRUE;
ELSIF Drone3Status THEN
  // 充电进度实时更新 - 使用系统时间计算，不受程序周期影响
  TimeRemaining := ChargingTime - (TON(CURT) - ChargingStartTime);
  IF TimeRemaining <= T#0S THEN
    Drone3Status := FALSE;
    ChargingStationStatus := FALSE;
  END_IF
END_IF

END_FUNCTION_BLOCK